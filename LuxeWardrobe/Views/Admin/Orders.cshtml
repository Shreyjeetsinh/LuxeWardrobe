@model IEnumerable<LuxeWardrobe.Models.Order>
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewBag.Title = "Orders";
    var statuses = new[] { "Placed", "Processing", "Shipped", "Delivered", "Cancelled" };
}
<div class="container-fluid py-4 py-lg-5">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-end gap-3 mb-4">
        <div>
            <div class="eyebrow">ADMIN</div>
            <h1 class="display-6 mb-1">Orders</h1>
            <p class="text-secondary mb-0">Review customer orders and update their fulfillment status.</p>
        </div>
        <a class="btn btn-outline-dark rounded-pill align-self-start align-self-md-auto" href="@Url.Action("Dashboard", "Admin")">Dashboard</a>
    </div>

    <div class="table-responsive bg-white border rounded-4 admin-orders-table d-none d-md-block">
        <table class="table align-middle mb-0">
            <thead>
                <tr>
                    <th>Order</th>
                    <th>Customer</th>
                    <th>Total</th>
                    <th>Placed</th>
                    <th>Status</th>
                    <th>Update</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var order in Model)
            {
                <tr>
                    <td><strong>@order.OrderNumber</strong><div class="small text-secondary">@order.Items.Count item line(s)</div></td>
                    <td>@order.CustomerName<div class="small text-secondary">@order.Email</div></td>
                    <td>&#8377;@order.Total.ToString("N0")</td>
                    <td>@order.OrderedAtUtc.ToLocalTime().ToString("dd MMM yyyy HH:mm")</td>
                    <td><span class="badge text-bg-light border">@order.Status</span></td>
                    <td>
                        @using (Html.BeginForm("UpdateStatus", "Admin", FormMethod.Post, new { @class = "d-flex gap-2" }))
                        {
                            @Html.AntiForgeryToken()
                            @Html.Hidden("id", order.Id)
                            <select name="status" class="form-select form-select-sm">
                                @foreach (var s in statuses)
                                {
                                    <option value="@s" @(order.Status == s ? "selected" : "")>@s</option>
                                }
                            </select>
                            <button class="btn btn-sm btn-dark">Save</button>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>

    <div class="admin-mobile-list d-md-none">
        @foreach (var order in Model)
        {
            <article class="admin-order-mobile-card">
                <div class="d-flex justify-content-between align-items-start gap-3">
                    <div class="min-w-0">
                        <strong class="d-block text-break">@order.OrderNumber</strong>
                        <div class="small text-secondary">@order.OrderedAtUtc.ToLocalTime().ToString("dd MMM yyyy, HH:mm")</div>
                    </div>
                    <span class="badge text-bg-light border flex-shrink-0">@order.Status</span>
                </div>

                <div class="admin-mobile-meta">
                    <span><small>Customer</small><strong class="text-break">@order.CustomerName</strong></span>
                    <span><small>Total</small><strong>&#8377;@order.Total.ToString("N0")</strong></span>
                    <span><small>Email</small><strong class="text-break">@order.Email</strong></span>
                    <span><small>Items</small><strong>@order.Items.Count line(s)</strong></span>
                </div>

                @using (Html.BeginForm("UpdateStatus", "Admin", FormMethod.Post, new { @class = "admin-order-status-form" }))
                {
                    @Html.AntiForgeryToken()
                    @Html.Hidden("id", order.Id)
                    <select name="status" class="form-select">
                        @foreach (var s in statuses)
                        {
                            <option value="@s" @(order.Status == s ? "selected" : "")>@s</option>
                        }
                    </select>
                    <button class="btn btn-dark" type="submit">Update status</button>
                }
            </article>
        }
    </div>
</div>