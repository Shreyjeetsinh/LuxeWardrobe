@model IEnumerable<LuxeWardrobe.Models.Order>
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewBag.Title = "Orders";
    var statuses = new[] { "Placed", "Processing", "Shipped", "Delivered", "Cancelled" };
}
<div class="container py-5">
    <div class="d-flex justify-content-between align-items-end mb-4"><div><div class="eyebrow">ADMIN</div><h1 class="display-6 mb-0">Orders</h1></div><a class="btn btn-outline-dark rounded-pill" href="@Url.Action("Dashboard", "Admin")">Dashboard</a></div>
    <div class="table-responsive bg-white border rounded-4"><table class="table align-middle mb-0"><thead><tr><th>Order</th><th>Customer</th><th>Total</th><th>Placed</th><th>Status</th><th></th></tr></thead><tbody>
    @foreach (var order in Model)
    {
        <tr><td><strong>@order.OrderNumber</strong><div class="small text-secondary">@order.Items.Count item line(s)</div></td><td>@order.CustomerName<div class="small text-secondary">@order.Email</div></td><td>&#8377;@order.Total.ToString("N0")</td><td>@order.OrderedAtUtc.ToLocalTime().ToString("dd MMM yyyy HH:mm")</td><td><span class="badge text-bg-light border">@order.Status</span></td><td>
            @using (Html.BeginForm("UpdateStatus", "Admin", FormMethod.Post, new { @class = "d-flex gap-2" }))
            {
                @Html.AntiForgeryToken() @Html.Hidden("id", order.Id)
                <select name="status" class="form-select form-select-sm">@foreach(var s in statuses){<option value="@s" @(order.Status == s ? "selected" : "")>@s</option>}</select>
                <button class="btn btn-sm btn-dark">Save</button>
            }
        </td></tr>
    }
    </tbody></table></div>
</div>
