@model LuxeWardrobe.ViewModels.AdminLoginViewModel
@{
    ViewBag.Title = "Admin login";
}
<div class="container py-6">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-4">
            <div class="summary-card">
                <div class="eyebrow">LUXEWARDROBE ADMIN</div>
                <h1 class="h2 mb-4">Sign in</h1>

                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-danger alert-dismissible fade show validation-summary-errors" role="alert">
                        <div class="fw-semibold mb-1"><i class="bi bi-exclamation-triangle-fill me-2"></i>Unable to sign in</div>
                        @Html.ValidationSummary(false, "", new { @class = "mb-0" })
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                @using (Html.BeginForm("Login", "Admin", new { returnUrl = ViewBag.ReturnUrl }, FormMethod.Post, new { }))
                {
                    @Html.AntiForgeryToken()
                    <div class="mb-3">
                        <label class="form-label">Username</label>
                        @Html.TextBoxFor(x => x.Username, new { @class = "form-control", autocomplete = "username", required = "required", placeholder = "Enter username" })
                        @Html.ValidationMessageFor(x => x.Username, "", new { @class = "text-danger small" })
                    </div>
                    <div class="mb-4">
                        <label class="form-label">Password</label>
                        @Html.PasswordFor(x => x.Password, new { @class = "form-control", autocomplete = "current-password", required = "required", placeholder = "Enter password" })
                        @Html.ValidationMessageFor(x => x.Password, "", new { @class = "text-danger small" })
                    </div>
                    <button class="btn btn-dark w-100 rounded-pill" type="submit">Sign in</button>
                }
            </div>
        </div>
    </div>
</div>