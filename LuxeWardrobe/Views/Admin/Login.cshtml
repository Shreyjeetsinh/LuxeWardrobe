@model LuxeWardrobe.ViewModels.AdminLoginViewModel
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewBag.Title = "Admin login";
}
<div class="admin-login-form">
    <div class="eyebrow">LUXEWARDROBE ADMIN</div>
    <h1 class="display-6 fw-semibold mt-2 mb-2">Welcome back</h1>
    <p class="text-secondary mb-4">Sign in to manage products, inventory and orders.</p>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger alert-dismissible fade show validation-summary-errors" role="alert">
            <div class="fw-semibold mb-1"><i class="bi bi-exclamation-triangle-fill me-2"></i>Unable to sign in</div>
            @Html.ValidationSummary(false, "", new { @class = "mb-0" })
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @using (Html.BeginForm("Login", "Admin", new { returnUrl = ViewBag.ReturnUrl }, FormMethod.Post, null))
    {
        @Html.AntiForgeryToken()

        <div class="mb-3">
            <label class="form-label fw-semibold">Username</label>
            <div class="input-group admin-login-input">
                <span class="input-group-text"><i class="bi bi-person"></i></span>
                @Html.TextBoxFor(x => x.Username, new { @class = "form-control", autocomplete = "username", placeholder = "Enter username" })
            </div>
            @Html.ValidationMessageFor(x => x.Username, "", new { @class = "text-danger small" })
        </div>

        <div class="mb-4">
            <label class="form-label fw-semibold">Password</label>
            <div class="input-group admin-login-input">
                <span class="input-group-text"><i class="bi bi-lock"></i></span>
                @Html.PasswordFor(x => x.Password, new { @class = "form-control", autocomplete = "current-password", placeholder = "Enter password" })
            </div>
            @Html.ValidationMessageFor(x => x.Password, "", new { @class = "text-danger small" })
        </div>

        <button class="btn btn-dark btn-lg w-100 rounded-pill" type="submit">
            Sign in <i class="bi bi-arrow-right ms-1"></i>
        </button>
    }

    <div class="admin-login-security mt-4">
        <i class="bi bi-shield-check"></i>
        <span>Admin access is separate from customer accounts.</span>
    </div>
</div>