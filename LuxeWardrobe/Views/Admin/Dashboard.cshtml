@model LuxeWardrobe.ViewModels.AdminDashboardViewModel
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewBag.Title = "Admin dashboard";
}
<div class="container-fluid py-4 py-lg-5">
    <div class="admin-head">
        <div>
            <div class="eyebrow">ADMIN</div>
            <h1 class="display-6 mb-1">Dashboard</h1>
            <p class="text-secondary mb-0">Quick view of products, orders and store performance.</p>
        </div>
    </div>

    <div class="row g-3 mt-2">
        <div class="col-6 col-xl-3"><div class="metric-card"><span>Active products</span><strong>@Model.ActiveProducts</strong></div></div>
        <div class="col-6 col-xl-3"><div class="metric-card"><span>Total orders</span><strong>@Model.TotalOrders</strong></div></div>
        <div class="col-6 col-xl-3"><div class="metric-card"><span>Open orders</span><strong>@Model.PendingOrders</strong></div></div>
        <div class="col-6 col-xl-3"><div class="metric-card"><span>Revenue</span><strong>&#8377;@Model.Revenue.ToString("N0")</strong></div></div>
    </div>

    <div class="row g-3 mt-2">
        <div class="col-12 col-md-6">
            <a class="admin-link-card h-100" href="@Url.Action("Index", "AdminProducts")">
                <i class="bi bi-box-seam"></i>
                <span><strong>Manage products</strong><small>Pricing, images, visibility and stock by size</small></span>
                <i class="bi bi-arrow-right"></i>
            </a>
        </div>
        <div class="col-12 col-md-6">
            <a class="admin-link-card h-100" href="@Url.Action("Orders", "Admin")">
                <i class="bi bi-receipt"></i>
                <span><strong>Manage orders</strong><small>Review customer orders and update fulfillment status</small></span>
                <i class="bi bi-arrow-right"></i>
            </a>
        </div>
    </div>
</div>