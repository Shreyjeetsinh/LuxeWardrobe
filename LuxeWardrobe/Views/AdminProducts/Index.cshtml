@using System.Collections.Generic
@using System.Linq
@model IEnumerable<LuxeWardrobe.Models.Product>
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewBag.Title = "Products";
    var primaryImageIds = ViewBag.PrimaryImageIds as IDictionary<int, int> ?? new Dictionary<int, int>();
}
<div class="container-fluid py-4 py-lg-5">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-end gap-3 mb-4">
        <div>
            <div class="eyebrow">ADMIN</div>
            <h1 class="display-6 mb-1">Products</h1>
            <p class="text-secondary mb-0">Manage storefront products, stock, pricing and images from one place.</p>
        </div>
        <a class="btn btn-dark rounded-pill px-4" href="@Url.Action("Create")"><i class="bi bi-plus-lg me-1"></i>Add product</a>
    </div>

    <div class="table-responsive bg-white border rounded-4 admin-products-table">
        <table class="table align-middle mb-0">
            <thead>
                <tr>
                    <th>Product</th>
                    <th>Category</th>
                    <th>Price</th>
                    <th>Stock</th>
                    <th>Storefront</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var product in Model)
            {
                <tr>
                    <td>
                        <div class="d-flex align-items-center gap-3">
                            @if (primaryImageIds.ContainsKey(product.Id))
                            {
                                <img src="@Url.Action("Image", "Products", new { id = primaryImageIds[product.Id] })" class="admin-thumb" alt="@product.Name" />
                            }
                            else
                            {
                                <img src="@Url.Content("~/Content/images/products/placeholder.svg")" class="admin-thumb" alt="@product.Name" />
                            }
                            <div>
                                <strong>@product.Name</strong>
                                <div class="small text-secondary">@product.Color</div>
                            </div>
                        </div>
                    </td>
                    <td>@product.Category</td>
                    <td>&#8377;@product.Price.ToString("N0")</td>
                    <td><span class="badge @(product.TotalStock > 0 ? "text-bg-light" : "text-bg-warning") border">@product.TotalStock</span></td>
                    <td>
                        @if (product.IsActive)
                        {
                            <span class="badge text-bg-success">Live</span>
                        }
                        else
                        {
                            <span class="badge text-bg-secondary">Hidden</span>
                        }
                    </td>
                    <td>
                        <div class="d-flex justify-content-end flex-wrap gap-2">
                            <a class="btn btn-sm btn-outline-secondary" target="_blank" href="@Url.Action("Details", "Products", new { id = product.Id })">Preview</a>
                            <a class="btn btn-sm btn-outline-dark" href="@Url.Action("Edit", new { id = product.Id })">Edit</a>
                            @if (product.IsActive)
                            {
                                using (Html.BeginForm("Delete", "AdminProducts", FormMethod.Post))
                                {
                                    @Html.AntiForgeryToken()
                                    @Html.Hidden("id", product.Id)
                                    <button class="btn btn-sm btn-outline-danger" onclick="return confirm('Hide this product from the storefront?')">Hide</button>
                                }
                            }
                        </div>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>