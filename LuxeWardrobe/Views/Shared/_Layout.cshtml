@using LuxeWardrobe.Services
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewBag.Title - LuxeWardrobe</title>
    <meta name="description" content="LuxeWardrobe - modern fashion storefront built with ASP.NET MVC 5." />
    <link rel="preconnect" href="https://cdn.jsdelivr.net" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
    <link href="@Url.Content("~/Content/site.css")" rel="stylesheet" />
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-light sticky-top luxe-nav">
        <div class="container py-2">
            <a class="navbar-brand luxe-brand" href="@Url.Action("Index", "Home")">LUXE<span>WARDROBE</span></a>
            <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"><span class="navbar-toggler-icon"></span></button>
            <div class="collapse navbar-collapse" id="mainNav">
                <ul class="navbar-nav ms-auto align-items-lg-center gap-lg-2">
                    <li class="nav-item"><a class="nav-link" href="@Url.Action("Index", "Home")">Shop</a></li>
                    <li class="nav-item"><a class="nav-link" href="@Url.Action("Track", "Order")">Track order</a></li>
                    <li class="nav-item"><a class="nav-link" href="@Url.Action("Login", "Admin")">Admin</a></li>
                    <li class="nav-item ms-lg-2">
                        <a class="btn btn-dark rounded-pill px-3" href="@Url.Action("Index", "Cart")">
                            <i class="bi bi-bag me-1"></i> Bag <span class="badge text-bg-light ms-1">@SessionCartService.Count(Session)</span>
                        </a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    @if (TempData["Success"] != null)
    {
        <div class="container mt-3"><div class="alert alert-success border-0 shadow-sm auto-dismiss">@TempData["Success"]</div></div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="container mt-3"><div class="alert alert-danger border-0 shadow-sm auto-dismiss">@TempData["Error"]</div></div>
    }

    <main>@RenderBody()</main>

    <footer class="border-top mt-5 py-4 bg-white">
        <div class="container d-flex flex-column flex-md-row justify-content-between gap-2 small text-secondary">
            <span>© @DateTime.Now.Year LuxeWardrobe. Built with ASP.NET MVC 5.</span>
            <span>Designed by <a href="https://www.linkedin.com/in/shreyjeetsinh/" target="_blank" rel="noopener">Shreyjeetsinh Dodiya</a></span>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/js/bootstrap.bundle.min.js"></script>
    <script src="@Url.Content("~/Scripts/site.js")"></script>
    @RenderSection("scripts", required: false)
</body>
</html>
